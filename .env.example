# Senha única de acesso ao Forja
FORJA_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessão (texto aleatório longo)
FORJA_SECRET=gere-um-texto-aleatorio-com-32-caracteres-ou-mais
# Token só de leitura usado pelo lembrete das 21h (scripts/windows)
FORJA_STATUS_TOKEN=gere-outro-texto-aleatorio
# Postgres do Neon (a Vercel cria ao ligar o Neon). Vazio = dados em .data/forja.json
DATABASE_URL=
# Só em desenvolvimento: fixa o relógio do app, ex.: 2026-10-21T15:00:00-03:00
FORJA_NOW=

# Só desenvolvimento: arquivo de dados alternativo (ex.: .data/demo.json)
FORJA_DATA_FILE=
